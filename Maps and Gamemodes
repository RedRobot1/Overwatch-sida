<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maps and Gamemodes — Overwatch Information Site</title>
 
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
 
  <style>
    /* ---------- Hero med bakgrundsbild + titel ---------- */
    .maps-hero {
      position: relative;
      height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background-image:
        linear-gradient(rgba(8,16,25,0.55), rgba(8,16,25,0.85)),
        url("images/maps-hero.jpg");
      background-size: cover;
      background-position: center;
      border-bottom: 3px solid var(--ow-orange);
    }
 
    .maps-hero h1 {
      font-size: 2.6rem;
      margin: 0;
    }
 
    .back-link {
      position: absolute;
      top: 1.2rem;
      left: 1.5rem;
      font-family: var(--font-heading);
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-decoration: none;
      color: var(--ow-text);
      background: rgba(14, 26, 36, 0.7);
      border: 1px solid var(--ow-border);
      padding: 0.5rem 1rem;
      border-radius: 3px;
      transition: all 0.2s ease;
    }
 
    .back-link:hover {
      color: var(--ow-orange);
      border-color: var(--ow-orange);
    }
 
    /* ---------- Karta-grid, två och två ---------- */
    .map-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 2rem;
    }
 
    .map-tile {
      position: relative;
      height: 280px;
      border-radius: 6px;
      overflow: hidden;
      background-size: cover;
      background-position: center;
      border: 1px solid var(--ow-border);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
 
    .map-tile:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(249, 158, 26, 0.2);
    }
 
    /* Mörkt overlay ovanpå bilden så texten syns tydligt */
    .map-tile::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8,16,25,0.15) 0%, rgba(8,16,25,0.55) 55%, rgba(8,16,25,0.92) 100%);
    }
 
    .map-tile-content {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.2rem;
    }
 
    .map-tile-content h3 {
      font-size: 1.3rem;
      color: var(--ow-white);
      margin-bottom: 0.4rem;
      text-shadow: 0 2px 8px rgba(0,0,0,0.6);
    }
 
    .map-info {
      font-size: 0.85rem;
      color: var(--ow-text);
      line-height: 1.5;
    }
 
    .map-info strong {
      color: var(--ow-orange);
      font-family: var(--font-heading);
      font-size: 0.7rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
 
    .map-info p {
      margin-bottom: 0.3rem;
    }
 
    @media (max-width: 700px) {
      .map-grid {
        grid-template-columns: 1fr;
      }
      .maps-hero h1 {
        font-size: 1.8rem;
      }
    }
  </style>
</head>
<body>
 
  <div class="maps-hero">
    <a href="index.html" class="back-link">&larr; Tillbaka</a>
    <h1>Maps and Gamemodes</h1>
  </div>
 
  <section class="map-grid">
 
    <div class="map-tile" style="background-image: url('images/maps/kings-row.jpg');">
      <div class="map-tile-content">
        <h3>King's Row</h3>
        <div class="map-info">
          <p><strong>Gamemode:</strong> Hybrid</p>
          <p><strong>Land:</strong> England</p>
          <p><strong>Karaktärer:</strong> Tracer, Reaper, Widowmaker</p>
        </div>
      </div>
    </div>
 
    <div class="map-tile" style="background-image: url('images/maps/hanamura.jpg');">
      <div class="map-tile-content">
        <h3>Hanamura</h3>
        <div class="map-info">
          <p><strong>Gamemode:</strong> Assault</p>
          <p><strong>Land:</strong> Japan</p>
          <p><strong>Karaktärer:</strong> Genji, Hanzo</p>
        </div>
      </div>
    </div>
 
    <div class="map-tile" style="background-image: url('images/maps/dorado.jpg');">
      <div class="map-tile-content">
        <h3>Dorado</h3>
        <div class="map-info">
          <p><strong>Gamemode:</strong> Escort</p>
          <p><strong>Land:</strong> Mexiko</p>
          <p><strong>Karaktärer:</strong> Sombra, Soldier: 76</p>
        </div>
      </div>
    </div>
 
    <div class="map-tile" style="background-image: url('images/maps/ilios.jpg');">
      <div class="map-tile-content">
        <h3>Ilios</h3>
        <div class="map-info">
          <p><strong>Gamemode:</strong> Control</p>
          <p><strong>Land:</strong> Grekland</p>
          <p><strong>Karaktärer:</strong> Pharah, Echo</p>
        </div>
      </div>
    </div>
 
    <!-- Lägg till fler .map-tile block här på samma sätt -->
 
  </section>
 
  <footer>
    &copy; 2026 Overwatch Information Site — fanprojekt, ej kopplat till Blizzard Entertainment.
  </footer>
 
</body>
</html>
